---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' }
]
---

<PageLayout title='Projects' {headings}>
  <p>만들고 있는 것들과 공부한 기록입니다.</p>

  <p>GitHub Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/GwonDooHyeon'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  {/*
    프로젝트를 추가하려면 아래 배열에 항목을 넣으세요.
    links 의 type 은 github / site / doc / release 중에서 고를 수 있습니다.
    image 는 src/assets/projects/ 안의 파일 이름을 넣으면 썸네일로 붙습니다.
  */}
  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '📝 개발 블로그',
        description: 'Astro 로 만든 개인 기술 블로그',
        links: [
          { type: 'github', href: 'https://github.com/GwonDooHyeon/blog-pure' },
          { type: 'site', href: 'https://GwonDooHyeon.github.io' }
        ]
      }
    ]}
  />

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'GitHub',
        description: '공부한 것들을 정리해 두는 곳',
        links: [{ type: 'github', href: 'https://github.com/GwonDooHyeon' }]
      }
    ]}
  />
</PageLayout>
